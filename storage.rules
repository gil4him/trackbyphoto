rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Photos live at: photos/{uid}/{photoId}.jpg
    match /photos/{uid}/{photoFile} {
      allow read:           if request.auth != null && request.auth.uid == uid;
      // create/update need size + content-type checks. delete has no
      // request.resource, so split it out — those checks would always fail.
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.size < 8 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete:         if request.auth != null && request.auth.uid == uid;
    }

    // Photos family send to a parent: familyPhotos/{patientUid}/{id}.jpg
    // Uploaded by an active family member of that parent (the record's own
    // rules decide who may send); seen by the parent's phone and the family
    // through the worker's link. Removed by the sender through the record,
    // or by whoever manages the parent's records.
    match /familyPhotos/{patientUid}/{file} {
      function membershipPath() {
        return /databases/(default)/documents/memberships/$(patientUid + '_' + request.auth.uid);
      }
      function member() {
        return request.auth != null && request.auth.uid != patientUid
          && firestore.exists(membershipPath())
          && firestore.get(membershipPath()).data.status == 'active';
      }
      allow read:   if request.auth != null && (request.auth.uid == patientUid || member());
      allow create: if member()
                    && request.resource.size < 8 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update: if false;
      allow delete: if member();
    }

    // The parent's voice replies: voice/{uid}/{memoId}/{reactionId}.{webm|m4a}
    // Only that parent's phone uploads them (a reply is at most 15 s). Nobody
    // reads them here: the worker hands the family a tokenized link, the same
    // way photos are shown.
    match /voice/{uid}/{memoId}/{clip} {
      allow read:   if false;
      // update too: when an upload arrives but its answer is lost on a weak
      // connection, the phone sends the same clip again to the same path.
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.size < 2 * 1024 * 1024
                            && request.resource.contentType.matches('audio/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
