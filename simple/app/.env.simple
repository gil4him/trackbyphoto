# Simple-core build config (`npm run build:simple` = vite build --mode simple).
# app/vite.config.ts points Vite's envDir at this folder for that mode, so the
# simple build reads this file (plus a simple/app/.env.local of your own, if
# any) and never app/.env.production or app/.env.local.
#
# Committed on purpose, like app/.env.production: public, browser-shipped web
# identifiers for the separate Firebase project daylie-simple-4df13.
VITE_EDITION=simple
VITE_PUBLIC_URL=https://dayliesimple.web.app
VITE_FIREBASE_API_KEY=AIzaSyA4WffkVNuPnjZxEklUy_EEvbSJIpROVbw
VITE_FIREBASE_AUTH_DOMAIN=daylie-simple-4df13.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=daylie-simple-4df13
VITE_FIREBASE_STORAGE_BUCKET=daylie-simple-4df13.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=99411030280
VITE_FIREBASE_APP_ID=1:99411030280:web:d8ee58f615f002b871fcbd
VITE_USE_EMULATOR=0
# The simple site's own Kakao JavaScript key (locked to the dayliesimple domains).
VITE_KAKAO_JS_KEY=9344ce957883f4375bb8057896d153d1
# The App Store page of Daylie (com.zymer.daylie, live since 2026-10-20), for
# the /pair link page and the invite message. Empty would make an iPhone
# parent link the phone in the browser instead of installing the app.
VITE_APPSTORE_URL=https://apps.apple.com/app/id6821605732
# 1: Daylie is live on Google Play (2026-10-20). 0 would make the /pair page
# connect in the browser instead of linking to Play.
VITE_PLAY_LIVE=1
# Google Static Maps for 다녀온 곳 outside Korea (key restricted to the Static API + our referrers)
VITE_GOOGLE_MAPS_KEY=AIzaSyBk3ztKnf3twKbIgrbDz9l6JmsPbvUzZRQ
