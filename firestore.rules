rules_version = '2';

// ────────────────────────────────────────────────────────────────────────────
// TrackByPhoto Firestore security rules.
//
// Two access paths:
//   1. Self-managed elder: request.auth.uid == patientUid. The original path.
//   2. Caregiver share: an active membership doc grants the caregiver scoped
//      access (read for viewers; write for admin/guardian) per the role.
//
// Membership is the source of truth (custom claims will mirror it as a cache
// later, but the rules read from Firestore for instant revocation). Every
// sensitive write also requires an auditLog write — that's enforced at the
// application layer, not here, because Firestore rules can't atomically gate
// "write A only if you also write B."
//
// See TrackByPhoto-Plan.md §7 (PIPA consent) and Appendix C for the spec.
// ────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // Super-admin: the one Google account that runs deployment can read every
    // memo + the admin counters. Email is signed into the auth token, so this
    // is a single fixed identity, not a role flag in Firestore.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'zymer4him@gmail.com';
    }

    function signedIn() {
      return request.auth != null;
    }

    // Family-managed elder's phone: a custom token minted by the worker's
    // pairing handlers, carrying { elder: true, deviceId }. Such a session
    // can take photos and read its own records, but never change settings
    // or sharing — family owns those. Every elder-session access also checks
    // that its device is still linked, so 연결 해제 cuts the phone off at once.
    function elderSession() {
      return signedIn() && request.auth.token.get('elder', false) == true;
    }

    function elderDeviceActive() {
      return !elderSession()
        || get(/databases/$(database)/documents/users/$(request.auth.uid)/devices/$(request.auth.token.deviceId)).data.status == 'active';
    }

    // Short-lived anonymous session a phone uses only to redeem a pairing code.
    function anonSession() {
      return signedIn() && request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'anonymous';
    }

    function isOwner(patientUid) {
      return signedIn() && request.auth.uid == patientUid && elderDeviceActive();
    }

    // Deterministic membership doc id keeps the rule fast (no query, just a
    // get()). Same shape on the client when it writes.
    function membershipId(patientUid) {
      return patientUid + '_' + request.auth.uid;
    }

    function membershipPath(patientUid) {
      return /databases/$(database)/documents/memberships/$(membershipId(patientUid));
    }

    function membership(patientUid) {
      return get(membershipPath(patientUid)).data;
    }

    function hasMembership(patientUid) {
      return signedIn() && exists(membershipPath(patientUid));
    }

    function isActive(patientUid) {
      return hasMembership(patientUid)
        && membership(patientUid).status == 'active';
    }

    function hasRole(patientUid, role) {
      return isActive(patientUid)
        && membership(patientUid).role == role;
    }

    // Admin (caregiver-side) and guardian have write authority over the
    // patient's settings/recipients. Owner always has it too. Viewer doesn't.
    function canManage(patientUid) {
      return isOwner(patientUid)
        || hasRole(patientUid, 'admin')
        || hasRole(patientUid, 'guardian');
    }

    function canRead(patientUid) {
      return isOwner(patientUid) || isActive(patientUid);
    }

    // ────────────────────────────────────────────────────────────────────
    // memos/{memoId}
    //
    // Read: patient themselves, any active caregiver (regardless of role —
    // even viewers see memos), or admin.
    // Create: the patient, right after uploading their photo, as a 'pending'
    // job for the Mac mini worker (admin SDK) to fill in. The doc must point
    // at the creator's own photo folder and carry only the placeholder shape,
    // so a client can't pre-mark a memo ready or claim someone else's photo.
    // Update/delete: patient or admin/guardian caregiver. Plain viewers
    // cannot edit memos.
    // ────────────────────────────────────────────────────────────────────
    match /memos/{memoId} {
      allow read:   if isAdmin() || canRead(resource.data.patientUid);
      allow create: if isOwner(request.resource.data.patientUid)
                    && request.resource.data.status == 'pending'
                    && request.resource.data.photoPath is string
                    && request.resource.data.photoPath.matches('photos/' + request.auth.uid + '/[^/]+')
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.keys().hasOnly([
                         'patientUid', 'photoPath', 'photoUrl', 'takenAt', 'lat', 'lng',
                         'place', 'activity', 'memo', 'scene', 'status', 'createdAt',
                         'tags', 'deviceMemo', 'deviceMemoSource', 'tzOffsetMin'
                       ]);
      allow update, delete: if canManage(resource.data.patientUid);
    }

    // ────────────────────────────────────────────────────────────────────
    // users/{patientUid}
    //
    // Settings doc lives here (recipients, cadence, retention…). Caregivers
    // need to read it to see who's getting memos; admin/guardian can edit it.
    // ────────────────────────────────────────────────────────────────────
    match /users/{patientUid} {
      allow read:  if isAdmin() || canRead(patientUid);
      // Writers must stamp themselves as lastModifiedBy. That field is the
      // trusted actor the worker's settings audit attributes the change
      // to — without this a caregiver could edit the elder's recipients and
      // frame it as the elder's own edit, dodging the audit log + notice.
      allow write: if (isOwner(patientUid) || canManage(patientUid))
                   && !elderSession()
                   && request.resource.data.lastModifiedBy == request.auth.uid;

      // users/{patientUid}/devices/{deviceId} — phones linked to a family-
      // managed elder. Written only by the worker (pair / unlink); family and
      // the elder's own phone may read them.
      match /devices/{deviceId} {
        allow read:  if isAdmin() || canRead(patientUid);
        allow write: if false;
      }
    }

    // ────────────────────────────────────────────────────────────────────
    // pairings/{id}
    //
    // One-time codes that link an elder's phone (only a hash is stored).
    // Written only by the worker. Family managers read them to see pending
    // re-link requests; the phone that claimed one may read it while it
    // waits for approval.
    // ────────────────────────────────────────────────────────────────────
    match /pairings/{pairingId} {
      allow read: if (canManage(resource.data.patientUid) && !elderSession())
                  || (signedIn() && request.auth.uid == resource.data.claimedBy);
      allow write: if false;
    }

    // ────────────────────────────────────────────────────────────────────
    // memberships/{membershipId}     id = patientUid + '_' + caregiverUid
    //
    // Memberships are created and mutated ONLY by the Mac mini worker's
    // caregiver-share handlers (createInvite / acceptInvite / revokeMembership),
    // which run via the admin SDK and bypass these rules. Direct client create/update is
    // denied on purpose: an earlier draft let a caregiver flip their own row
    // invited → active by referencing *any* consent on file for the patient,
    // which sidesteps the one-shot invite code entirely. The worker request is
    // the only sanctioned path to active access.
    //
    // Read: the patient or the caregiver on the row, plus admin.
    // Delete: patient, guardian, or the caregiver themselves. Delete only ever
    // REMOVES access (never grants it), so it's a safe client-side safety valve
    // for instant self-removal / revocation without a round-trip to the worker.
    // ────────────────────────────────────────────────────────────────────
    match /memberships/{membershipId} {
      // Family who manage the elder also see the elder's other family rows,
      // so a guardian of a family-managed elder can run 가족 관리.
      allow read: if isAdmin()
                  || (signedIn() && (
                       request.auth.uid == resource.data.patientUid
                    || request.auth.uid == resource.data.caregiverUid))
                  || (canManage(resource.data.patientUid) && !elderSession());

      allow create: if false;
      allow update: if false;

      allow delete: if (isOwner(resource.data.patientUid) && !elderSession())
                    || hasRole(resource.data.patientUid, 'guardian')
                    || (signedIn() && request.auth.uid == resource.data.caregiverUid);
    }

    // ────────────────────────────────────────────────────────────────────
    // invites/{code}
    //
    // 6-digit codes (or share-link tokens) the elder hands to a caregiver.
    // Create: owner or admin caregiver. Get: anyone signed in (the invitee's
    // confirm screen looks up the code from their link). List: nobody, so
    // live codes can't be enumerated. Update/delete: creator path
    // only. The worker handler that converts an invite → membership runs as
    // admin and bypasses these rules.
    // ────────────────────────────────────────────────────────────────────
    match /invites/{code} {
      allow get:    if signedIn();
      allow list:   if false;
      allow create: if signedIn()
                    && !elderSession()
                    && request.resource.data.used == false
                    && (
                         request.auth.uid == request.resource.data.patientUid
                      || hasRole(request.resource.data.patientUid, 'admin')
                       );
      allow update, delete: if (isOwner(resource.data.patientUid) && !elderSession())
                            || hasRole(resource.data.patientUid, 'admin');
    }

    // ────────────────────────────────────────────────────────────────────
    // consents/{consentId}
    //
    // PIPA evidence. Create: the patient themselves (self consent) or a
    // guardian on their behalf. Once written, consents are immutable — they
    // are the legal record. Read: owner, any active caregiver on that
    // patient (so the dashboard can show "consent on file"), and admin.
    // ────────────────────────────────────────────────────────────────────
    match /consents/{consentId} {
      allow read: if isAdmin()
                  || canRead(resource.data.patientUid);

      // Self consent: the patient writes their own. Guardian consent: a
      // signed-in user writing for a different patientUid with grantedBy =
      // 'guardian' and themselves named as guardianUid. The legal validity
      // of a guardian doc is verified out-of-band (court appointment); the
      // rule just enforces the shape.
      allow create: if signedIn()
                    && request.resource.data.timestamp == request.time
                    && (
                         (
                           request.resource.data.grantedBy == 'self'
                           && request.auth.uid == request.resource.data.patientUid
                           && request.resource.data.guardianUid == null
                         )
                      || (
                           request.resource.data.grantedBy == 'guardian'
                           && request.auth.uid == request.resource.data.guardianUid
                         )
                       );

      // Consents are immutable evidence.
      allow update, delete: if false;
    }

    // ────────────────────────────────────────────────────────────────────
    // auditLogs/{logId}
    //
    // Append-only. Anyone who can manage the patient may write a log
    // describing what they did. Read: owner, active caregivers, admin.
    // Update/delete: never — the whole point is tamper resistance.
    // ────────────────────────────────────────────────────────────────────
    match /auditLogs/{logId} {
      allow read: if isAdmin()
                  || canRead(resource.data.patientUid);
      allow create: if signedIn()
                    && request.resource.data.actorUid == request.auth.uid
                    && request.resource.data.timestamp == request.time
                    && (
                         isOwner(request.resource.data.patientUid)
                      || isActive(request.resource.data.patientUid)
                       );
      allow update, delete: if false;
    }

    // ────────────────────────────────────────────────────────────────────
    // notifications/{id}
    //
    // Per-recipient feed. `recipientUid` is whoever the notice is addressed to:
    //   - elder safeguard notices (§8): recipientUid == patientUid
    //   - caregiver new-photo notices: recipientUid == that caregiver's uid
    // Only the recipient (and super-admin) may read it. Written exclusively by
    // the Mac mini worker (admin SDK). The recipient may mark a notice read (only
    // that field) or dismiss it.
    // ────────────────────────────────────────────────────────────────────
    match /notifications/{id} {
      allow read:   if isAdmin()
                    || (signedIn() && request.auth.uid == resource.data.recipientUid && elderDeviceActive());
      allow create: if false;
      allow update: if signedIn() && request.auth.uid == resource.data.recipientUid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if signedIn() && request.auth.uid == resource.data.recipientUid;
    }

    // ────────────────────────────────────────────────────────────────────
    // requests/{id}
    //
    // Work queue for the Mac mini worker — the replacement for HTTPS
    // callables. The worker trusts uid/email/name on the doc as the caller's
    // identity, so create pins them to the verified auth token, and clients
    // can never update the doc (the worker writes the result via admin SDK).
    // The caller reads its own result, then deletes the doc.
    // ────────────────────────────────────────────────────────────────────
    match /requests/{id} {
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['type', 'uid', 'email', 'name', 'payload', 'status', 'createdAt'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.email == request.auth.token.get('email', null)
                    && request.resource.data.name == request.auth.token.get('name', null)
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.payload is map
                    // Must match HANDLERS in worker/src/handlers/requests.ts.
                    && request.resource.data.type in [
                         'createInvite', 'acceptInvite', 'revokeMembership', 'setMembershipRole',
                         'syncCaregiverName', 'regenerateMemo', 'backfillMemoSchema', 'backfillPatientUid',
                         'createManagedElder', 'createPairingLink', 'approvePairing', 'unlinkDevice', 'deleteManagedElder',
                         'pairDevice', 'completePairing'
                       ]
                    // An elder's phone makes no requests; an anonymous
                    // session may only redeem a pairing code.
                    && !elderSession()
                    && (!anonSession() || request.resource.data.type in ['pairDevice', 'completePairing']);
      allow read, delete: if signedIn() && request.auth.uid == resource.data.uid;
      allow update: if false;
    }

    // ────────────────────────────────────────────────────────────────────
    // Admin dashboard (unchanged from pre-share).
    // ────────────────────────────────────────────────────────────────────
    match /admin_totals/{doc} {
      allow read:  if isAdmin();
      allow write: if false;
    }
    match /admin_daily/{doc} {
      allow read:  if isAdmin();
      allow write: if false;
    }
    match /admin_config/{doc} {
      allow read, write: if isAdmin();
    }
  }
}
