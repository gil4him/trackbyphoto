# Simple-core build config (`npm run build:simple` = vite build --mode simple).
# Vite loads this instead of .env.production, and it overrides .env.local.
#
# Committed on purpose, like .env.production: public, browser-shipped web
# identifiers for the separate Firebase project daylie-simple-4df13.
VITE_EDITION=simple
VITE_PUBLIC_URL=https://dayliesimple.web.app
VITE_FIREBASE_API_KEY=AIzaSyA4WffkVNuPnjZxEklUy_EEvbSJIpROVbw
VITE_FIREBASE_AUTH_DOMAIN=daylie-simple-4df13.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=daylie-simple-4df13
VITE_FIREBASE_STORAGE_BUCKET=daylie-simple-4df13.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=99411030280
VITE_FIREBASE_APP_ID=1:99411030280:web:d8ee58f615f002b871fcbd
VITE_USE_EMULATOR=0
# Empty on purpose: the Kakao JS key is locked to the trackbyphoto domains, and
# leaving it blank overrides a local .env.local key so the Kakao button hides.
VITE_KAKAO_JS_KEY=
# The App Store page of 오늘하루 (https://apps.apple.com/app/id<number>), for
# the /pair link page. Empty until the App Store Connect record exists; the
# page then tells iPhone users to search the App Store instead.
VITE_APPSTORE_URL=
