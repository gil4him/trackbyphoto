# Production build config for every build, CI included (Vite loads this for
# `vite build`; a local .env.local still overrides it).
#
# Committed on purpose: these are public, browser-shipped identifiers — the
# same values are in the deployed bundle at trackbyphoto.web.app. Firebase
# web API keys are not secrets (access is enforced by security rules), and
# the Kakao JavaScript key is restricted to registered site domains.
# Without this file, CI-built iOS/Android apps had empty Firebase config and
# showed a blank screen at launch.
VITE_FIREBASE_API_KEY=AIzaSyAM7yF0-NyU5AaThIEvj7JS3ZB3Z520Oh0
VITE_FIREBASE_AUTH_DOMAIN=trackbyphoto-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=trackbyphoto-app
VITE_FIREBASE_STORAGE_BUCKET=trackbyphoto-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=2450507790
VITE_FIREBASE_APP_ID=1:2450507790:web:cb03f97944cf8cded6945f
VITE_KAKAO_JS_KEY=7d00de9dc9e5c16fc9804be0c43eb387
VITE_USE_EMULATOR=0
VITE_EDITION=full
VITE_PUBLIC_URL=https://trackbyphoto.web.app
