# Declares Fastlane (the release-automation tool) so `bundle install` sets it up
# at a known version for everyone, instead of relying on a global install.
source "https://rubygems.org"

gem "fastlane"

# Ruby 3.5+ no longer ships these as default gems; fastlane still requires them.
gem "ostruct"
gem "logger"
gem "benchmark"
gem "abbrev"
gem "mutex_m"
gem "nkf"
gem "csv"
gem "bigdecimal"
gem "base64"
